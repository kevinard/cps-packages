# The exact CPS commit that this recipe tree is written for, built with,
# and tested against. CPS formats are unreleased and change in place, so
# recipes track one commit and bump it deliberately; see CONTRIBUTING.md.
#
# Read by tools/cps.sh (POSIX sh: KEY=value, no spaces around "=").
CPS_COMMIT=1de46cab187690a73093cd59816c9a7e2552ffc7
# Default source for tools/cps.sh; override with CPS_SOURCE=PATH-or-URL.
CPS_URL=https://github.com/kevinard/cps.git
