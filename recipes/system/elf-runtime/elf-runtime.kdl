schema-version 1 kind="package-manifest"
package "system/elf-runtime" publisher="canopa" summary="glibc loader and C/GCC runtime libraries, repackaged from the stage0 seed" license="LGPL-2.1-or-later AND GPL-3.0-or-later WITH GCC-exception-3.1" homepage="https://www.gnu.org/software/libc/" {
    require "system/filesystem"
    file "usr/lib/ld-linux-x86-64.so.2" mode="0755" uid=0 gid=0
    file "usr/lib/libc.so.6" mode="0755" uid=0 gid=0
    file "usr/lib/libm.so.6" mode="0755" uid=0 gid=0
    file "usr/lib/libgcc_s.so.1" mode="0755" uid=0 gid=0
}
