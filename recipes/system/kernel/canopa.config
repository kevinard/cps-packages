# Settings applied on top of `make x86_64_defconfig` for Linux 6.12. Every
# line must survive `make olddefconfig` unchanged, or the build fails.
CONFIG_LOCALVERSION="-canopa"
# CONFIG_LOCALVERSION_AUTO is not set
# Root on Btrfs, booted by systemd-boot from a VFAT ESP; no initramfs needed
# for NVMe, SATA, or virtio disks.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# What systemd and CPS need: cgroups, namespaces for Bubblewrap, seccomp,
# openat2 (5.6+), and the usual systemd requirements.
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_DMIID=y
# Unsigned modules for now; module signing waits for the release key work.
# CONFIG_MODULE_SIG is not set
