schema-version 1 kind="package-manifest"
package "system/busybox" publisher="canopa" summary="Static multi-call binary for rescue shells and initramfs images" license="GPL-2.0-only" homepage="https://busybox.net/" {
    file "usr/bin/busybox" mode="0755" uid=0 gid=0
    symlink "usr/bin/sh" target="busybox" uid=0 gid=0
    mediate "usr/bin/sh" group="sh" priority=10
    file "usr/share/licenses/busybox/LICENSE" mode="0644" uid=0 gid=0
}
