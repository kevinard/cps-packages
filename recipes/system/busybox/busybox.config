# Settings applied on top of `make defconfig` for BusyBox 1.38.0. Every
# line must survive `make oldconfig` unchanged, or the build fails.
#
# A static binary, so the rescue shell works when the ELF runtime does not.
CONFIG_STATIC=y
# tc uses the CBQ qdisc API that Linux 6.8 removed from its UAPI headers.
# CONFIG_TC is not set
# Canopa uses systemd's units and udev, not BusyBox's init or mdev.
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_MDEV is not set
# CONFIG_RUNSV is not set
# CONFIG_RUNSVDIR is not set
# CONFIG_SV is not set
# CONFIG_SVC is not set
# CONFIG_SVOK is not set
# CONFIG_CHPST is not set
# CONFIG_SETUIDGID is not set
# CONFIG_ENVUIDGID is not set
# CONFIG_ENVDIR is not set
# CONFIG_SOFTLIMIT is not set
# Applets that need setuid root to work are not installed setuid.
# CONFIG_FEATURE_SUID is not set
