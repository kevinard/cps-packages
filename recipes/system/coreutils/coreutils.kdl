schema-version 1 kind="package-manifest"
package "system/coreutils" publisher="canopa" summary="GNU file, shell, and text utilities" license="GPL-3.0-or-later" homepage="https://www.gnu.org/software/coreutils/" {
    require "system/elf-runtime"
    collect "usr/bin/*"
    collect "usr/libexec/coreutils/*"
    collect "usr/share/man/**"
    collect "usr/share/licenses/**"
}
