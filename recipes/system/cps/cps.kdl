schema-version 1 kind="package-manifest"
package "system/cps" publisher="canopa" summary="Canopa Package System" license="MIT" homepage="https://github.com/kevinard/cps" {
    require "system/elf-runtime"
    require "library/libseccomp" version=">=2.6.1-1"
    require "library/sqlite" version=">=3.54.1-1"
    file "usr/bin/cps" mode="0755" uid=0 gid=0
    file "usr/lib/systemd/system/cps-boot-health.service" mode="0644" uid=0 gid=0
    file "usr/lib/systemd/system/cps-uefi-bless.service" mode="0644" uid=0 gid=0
    symlink "usr/lib/systemd/system/boot-complete.target.requires/cps-boot-health.service" target="../cps-boot-health.service" uid=0 gid=0
    file "usr/share/licenses/cps/LICENSE" mode="0644" uid=0 gid=0
}
